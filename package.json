{
  "name": "md2bl",
  "version": "0.4.2",
  "description": "A CLI tool and library to convert Markdown to Backlog notation",
  "type": "module",
  "main": "dist/lib.js",
  "types": "dist/lib.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/lib.d.ts",
        "default": "./dist/lib.js"
      }
    }
  },
  "bin": {
    "md2bl": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "format": "biome format --write",
    "format:check": "biome format",
    "typecheck": "tsc --noEmit",
    "check": "biome check && tsc --noEmit"
  },
  "keywords": [
    "markdown",
    "backlog",
    "converter",
    "cli",
    "library"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.30.3",
  "license": "MIT",
  "author": "ynoki10",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ynoki10/md2bl.git"
  },
  "homepage": "https://github.com/ynoki10/md2bl#readme",
  "bugs": {
    "url": "https://github.com/ynoki10/md2bl/issues"
  },
  "files": [
    "dist/",
    "README.md",
    "README.ja.md",
    "LICENSE"
  ],
  "dependencies": {
    "citty": "^0.2.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.0.0",
    "@types/unist": "^3.0.3",
    "tsx": "^4.19.2",
    "typescript": "^6.0.2",
    "vitest": "^2.1.9"
  }
}
